# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fotozamowienia?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-change-in-production"

# Redis (for job queue)
REDIS_URL="redis://localhost:6379"

# Storage
STORAGE_PATH="./uploads"
MAX_UPLOAD_SIZE_MB=50
ALLOWED_IMAGE_TYPES="image/jpeg,image/png,image/webp,image/tiff"

# Email (SMTP)
SMTP_HOST="smtp.ethereal.email"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@fotozamowienia.pl"

# Payment Gateway (sandbox mode)
PAYMENT_MODE="sandbox"
PAYMENT_SANDBOX_SUCCESS_RATE=100

# Multi-tenant
MAIN_DOMAIN="localhost:3000"
ENABLE_MULTI_TENANT=false

# Image processing
THUMBNAIL_QUALITY=80
PREVIEW_MAX_SIZE=1200
ORIGINAL_RETENTION_DAYS=90
